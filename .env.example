# ---- Infrastructure -----------------------------------------------------------------------------
POSTGRES_USER=osint
POSTGRES_PASSWORD=osint
POSTGRES_DB=osint
POSTGRES_PORT=5432
MEILI_MASTER_KEY=osint-dev-master-key
MEILI_PORT=7700
API_PORT=8000
WEB_PORT=8080

# ---- Backend (OSINT_* is read by backend/osint_board/config.py) --------------------------------
OSINT_ENV=dev
OSINT_LOG_LEVEL=INFO
# Refuse active modules (port scans, brute force, nuclei) unless an investigation scope allows them.
OSINT_PASSIVE_ONLY=true
# Optional egress proxy for all module traffic and a Tor SOCKS proxy for onion modules.
# OSINT_OUTBOUND_PROXY=http://proxy:3128
OSINT_TOR_SOCKS_PROXY=socks5h://tor:9050
# GeoIP databases (GeoLite2 / DB-IP Lite .mmdb) mounted into the containers.
# OSINT_GEOIP_CITY_DB=/data/geoip/GeoLite2-City.mmdb
# OSINT_GEOIP_ASN_DB=/data/geoip/GeoLite2-ASN.mmdb

# ---- Module credentials: OSINT_MODULE_<MODULE_ID>_<NAME> (see catalog/modules.yaml ids) --------
# Free keys worth getting first (all no-cost):
OSINT_MODULE_AISSTREAM_API_KEY=
OSINT_MODULE_NASA_FIRMS_API_KEY=
OSINT_MODULE_OPENCELLID_API_KEY=
OSINT_MODULE_WIGLE_API_KEY=
OSINT_MODULE_OPENSKY_USERNAME=
OSINT_MODULE_OPENSKY_PASSWORD=
OSINT_MODULE_ABUSE_CH_API_KEY=
OSINT_MODULE_THREATFOX_API_KEY=
OSINT_MODULE_ALIENVAULT_OTX_API_KEY=
OSINT_MODULE_GITHUB_API_KEY=
OSINT_MODULE_URLSCAN_API_KEY=
OSINT_MODULE_LEAKIX_API_KEY=
OSINT_MODULE_GOOGLE_SAFEBROWSING_API_KEY=
OSINT_MODULE_HYBRID_ANALYSIS_API_KEY=
OSINT_MODULE_MALTIVERSE_API_KEY=
OSINT_MODULE_ETHERSCAN_API_KEY=
OSINT_MODULE_FLICKR_API_KEY=
OSINT_MODULE_PROJECT_HONEYPOT_API_KEY=
OSINT_MODULE_LEAK_LOOKUP_API_KEY=
OSINT_MODULE_DNSDUMPSTER_API_KEY=
OSINT_MODULE_HACKERTARGET_API_KEY=
OSINT_MODULE_CIRCL_LU_USERNAME=
OSINT_MODULE_CIRCL_LU_PASSWORD=
# Tiered/commercial keys are optional: their capabilities are provided by internal services (docs/07-internal-replacements.md).
OSINT_MODULE_SHODAN_API_KEY=
OSINT_MODULE_VIRUSTOTAL_API_KEY=
OSINT_MODULE_ACLED_API_KEY=
OSINT_MODULE_ACLED_EMAIL=
